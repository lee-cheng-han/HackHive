# ML Service Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=3002
ENVIRONMENT=development
DEBUG=true

# Model Configuration
MODEL_PATH=./best_model.pth
DEVICE=auto
MAX_LENGTH=500

# Audio Configuration  
SAMPLE_RATE=22050
AUDIO_FORMAT=wav

# Whisper Configuration
WHISPER_MODEL=base

# API Configuration
MAX_WORKERS=1
REQUEST_TIMEOUT=30

# Backend Integration
BACKEND_URL=http://localhost:3001